# Copie para backend/.env e ajuste. Todos os valores são opcionais:
# sem .env, os padrões de app/config.py são usados.

# --- Ingestão ---
# Tamanho de cada chunk, em palavras. Com o e5 (limite de 512 tokens), não
# passe muito de 200: o script de indexação avisa se houver truncamento.
CHUNK_SIZE=200
# Palavras repetidas entre chunks consecutivos (deve ser < CHUNK_SIZE).
CHUNK_OVERLAP=40
# Cortar a seção de referências quando o título dela for encontrado.
REMOVE_REFERENCES=true

# --- Embeddings ---
# Trocar o modelo exige reindexar (ou usar outro COLLECTION_NAME).
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Vazio = automático (usa "mps" no Mac com Apple Silicon). Ou: cpu, mps, cuda.
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=16

# --- ChromaDB / recuperação ---
COLLECTION_NAME=articles
TOP_K=5

# --- LLM ---
# "ollama" (local, gratuito) ou "anthropic" (API).
LLM_PROVIDER=ollama
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120

# Anthropic: chave em https://console.anthropic.com (não commite o .env!)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# Ollama: instale em https://ollama.com e rode `ollama pull qwen2.5:7b`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.1

# --- API ---
# Lista em JSON. 4200 = porta padrão do Angular (ng serve).
CORS_ORIGINS=["http://localhost:4200"]
MAX_UPLOAD_MB=50
